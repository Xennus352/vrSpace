# Secret API keys for the AI + voice features.
# Copy this file to .env and fill in your real keys. .env is gitignored.

# Groq (LLM "AI brain")
GROQ_API_KEY=

# ElevenLabs (text-to-speech voice)
ELEVENLABS_API_KEY=

# Optional: local LLM fallback (e.g. Ollama). Leave blank to disable.
OLLAMA_URL=http://localhost:11434/api/generate

# ElevenLabs voice id used for FRIDAY
FRIDAY_VOICE_ID=EXAVITQu4vr4xnSDxMaL